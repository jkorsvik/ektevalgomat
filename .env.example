# Copy to .env before the first `docker compose build`.
#
# The domain suffix used in this container's Traefik host rule, so the
# router matches https://ektevalgomat.<PUBLIC_DOMAIN>. Use a real value
# such as `example.com`. If you are not behind a Traefik reverse proxy,
# set it to any placeholder; the labels are simply ignored.
PUBLIC_DOMAIN=example.com
