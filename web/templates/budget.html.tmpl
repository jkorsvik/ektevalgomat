<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{template "head" .Meta}}
</head>
<body>

{{template "header" .}}

{{/* The whole statsbudsjett as collected and analysed: the government's own
     headline figures, the per-department totals, and the findings that bear
     on the statements. This is the page that answers "hva foreslår
     regjeringen", to sit beside the promises (/partier) and the votes (the
     utsagn pages). A finding with no statement says so rather than being
     forced into the nearest one.

     This is a PROPOSAL page, not a result page. The budget presented
     2026-10-07 is the government's forslag; Stortinget has not voted yet.
     Nothing here may be phrased as something the budget "decided". */}}
<main>
  <h1>Budsjettet</h1>
  <section class="hero">
    <div class="hero-meta">
      <span class="hero-dimension">Statsbudsjettet</span>
      <span class="hero-number">{{.Budget.Year}}</span>
    </div>
    <p class="statement-text">Statsbudsjettet 2027, samlet og analysert.</p>
    <p class="budget-lede">{{.Budget.Summary}}</p>
    <p class="hero-question">
      <a href="{{.Budget.SourceURL}}" rel="noopener">{{.Budget.SourceName}}</a>
      {{if .Budget.Presented}}· lagt fram {{.Budget.Presented}}{{end}}
      {{if .Budget.RetrievedAt}}· hentet {{.Budget.RetrievedAt}}{{end}}
    </p>
    <p class="budget-status"><strong>Dette er et forslag, ikke et vedtak.</strong>
      Regjeringen la fram forslaget 7. oktober 2026. Stortinget behandler det nå,
      med finansinnstilling 30. november og rammevedtak 7. desember. Tallene på
      denne siden er regjeringens forslag. Ingenting er vedtatt ennå, og et parti
      kan derfor ikke få «brutt løfte» for et beløp som bare mangler i forslaget.</p>
  </section>

  <section class="budget-figures">
    {{range .Budget.KeyFigures}}
    <div class="budget-figure">
      <span class="budget-figure-label">{{.Label}}</span>
      <span class="budget-figure-value">{{.Value}}</span>
      <span class="budget-figure-note">{{.Note}}</span>
    </div>
    {{end}}
  </section>

  <details class="budget-section" open>
    <summary class="budget-section-sum"><h2>Utgifter per departement</h2></summary>
    <p class="budget-lede">Alle utgiftskapitler (1–2999, utenom kap. 2800), lagt sammen per departement, i millioner kroner. Kilde: Gul bok-datagrunnlaget for 2027 (én kolonne, forslaget) og 2026-filen ved siden av.
      Endringen sammenligner regjeringens to forslag, 2026 og 2027. Der Stortinget endret 2026-budsjettet etter at forslaget ble lagt fram, er den reelle forskjellen en annen. Bredbåndsposten under er et slikt tilfelle.</p>
    <table class="budget-table">
      <thead><tr><th>Departement</th><th class="num">Utgifter</th><th class="num">Endring</th></tr></thead>
      <tbody>
      {{range .Budget.Departments}}
        <tr>
          <td>{{.Name}}</td>
          <td class="num">{{nok .Amount}}</td>
          <td class="num change">{{pct .ChangePct}} %</td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </details>

  <details class="budget-section" open>
    <summary class="budget-section-sum"><h2>Partienes egne budsjetter</h2></summary>
    <p class="budget-lede">{{.PartyBudgetLede}}</p>
    <p class="budget-status">{{.PartyBudget.Areas}} rammeområder, {{.PartyBudget.Posts}} bevilgninger, sesjonen {{.PartyBudget.Session}}. Kilde: komiteinnstillingene for 2025–2026, kolonnekartet lest fra hver tabells egen overskrift.</p>
    <p class="party-budget-sort">
      Rekkefølge:
      <a href="/budsjett#partibudsjett"{{if not .PartyBudget.Sort}} aria-current="true"{{end}}>rammeområde</a>
      <a href="/budsjett?sort=spredning#partibudsjett"{{if eq .PartyBudget.Sort "spredning"}} aria-current="true"{{end}}>størst uenighet</a>
      <a href="/budsjett?sort=storrelse#partibudsjett"{{if eq .PartyBudget.Sort "storrelse"}} aria-current="true"{{end}}>størst beløp</a>
    </p>
    <table class="budget-table party-budget">
      <thead>
        <tr>
          <th>Rammeområde</th>
          {{range .PartyBudget.Cols}}<th class="num{{if .Joint}} joint{{end}}">{{.Label}}</th>{{end}}
          <th class="num">Spredning</th>
        </tr>
      </thead>
      <tbody>
        {{range .PartyBudget.Rows}}
        <tr{{if eq .Area $.PartyBudget.SelectedArea}} class="party-budget-open"{{end}}>
          <td><a href="?omrade={{.Area}}#partibudsjett">{{.Area}}</a> <span class="party-budget-posts">{{.Posts}} poster</span></td>
          {{range .Cells}}<td class="num change {{.Class}}{{if eq .Kind "fig"}} fig{{end}}">{{if eq .Kind "fig"}}<span class="party-bar b{{.Bucket}} {{.Class}}" aria-hidden="true"></span><span class="party-num">{{.Change}}</span>{{else if eq .Kind "blank"}}<span class="party-blank" title="Partiet har en kolonne her, men dokumentet oppgir ingen sum">?</span>{{else}}<span class="party-absent" title="Partiet er ikke med i denne komiteen og la ikke fram noe alternativ her">–</span>{{end}}</td>{{end}}
          <td class="num">{{.Spread}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>

    <div class="party-budget-common">
      <h3>Sammenlignbar sum</h3>
      <p>Summen av avvikene i de {{len .PartyBudget.Common.Areas}} rammeområdene der alle sju partiene har en kolonne (av {{.PartyBudget.Common.Of}}). Her er dekningen lik, så tallene kan sammenlignes; over alle rammeområdene kan de ikke det, fordi partiene er med i ulike komiteer.</p>
      <ul class="party-budget-common-list">
        {{range .PartyBudget.Common.Cols}}<li><span class="party-budget-common-name">{{.Label}}</span> <span class="num {{.Class}}">{{.Total}}</span></li>{{end}}
      </ul>
      <p class="party-budget-common-areas">Rammeområdene i summen:
        {{range $i, $a := .PartyBudget.Common.Areas}}{{if $i}}, {{end}}<a href="/budsjett?omrade={{$a}}#partibudsjett">{{$a}}</a>{{end}}.</p>
    </div>
    {{if ge .PartyBudget.SelectedArea 0}}
    <div id="partibudsjett" class="party-posts">
      <h3>Bevilgningene i rammeområde {{.PartyBudget.SelectedArea}}</h3>
      <p class="budget-lede">{{.PartyBudget.SelectedDoc}}. Hver kolonne viser avviket fra regjeringens forslag for posten, i milliarder kroner. {{len .PartyBudget.PostRows}} poster.</p>
      <table class="budget-table party-budget party-posts-table">
        <thead>
          <tr>
            <th>Kap./post</th>
            <th>Formål</th>
            {{range .PartyBudget.Cols}}<th class="num{{if .Joint}} joint{{end}}">{{.Label}}</th>{{end}}
          </tr>
        </thead>
        <tbody>
          {{range .PartyBudget.PostRows}}
          <tr>
            <td class="party-post-id">{{.Kap}}{{if .Post}}/{{.Post}}{{end}}</td>
            <td>{{.Formal}}</td>
            {{range .Cells}}<td class="num change {{.Class}}{{if eq .Kind "fig"}} fig{{end}}">{{if eq .Kind "fig"}}<span class="party-bar b{{.Bucket}} {{.Class}}" aria-hidden="true"></span><span class="party-num">{{.Change}}</span>{{else}}{{if eq .Kind "blank"}}<span class="party-blank">·</span>{{else}}<span class="party-absent">–</span>{{end}}{{end}}</td>{{end}}
          </tr>
          {{end}}
        </tbody>
      </table>
      <p class="budget-status">Kilde: <a href="{{.PartyBudget.SelectedURL}}">{{.PartyBudget.SelectedDoc}}</a>. Kolonnekartet er lest fra tabellens egen overskrift, og hver kolonne er kontrollert mot dokumentets egen sumrad.</p>
    </div>
    {{end}}
  </details>

  <details class="budget-section" open>
    <summary class="budget-section-sum"><h2>Hva regjeringen foreslår for 2027</h2></summary>
    <p class="budget-lede">Funn i forslaget som berører utsagnene. Hvert funn viser til utsagnet det gjelder, eller sier at ingen utsagn dekker det ennå. Dette er forslag, ikke vedtak.</p>
    {{range .Findings}}
    <article class="budget-finding">
      <h3>{{.Topic}}</h3>
      {{if .Quote}}<blockquote class="budget-quote">«{{.Quote}}»</blockquote>{{end}}
      {{if .Observations}}
      <table class="budget-obs">
        <thead><tr><th>Budsjettår</th><th>Hva tallet er</th><th class="num">Beløp</th></tr></thead>
        <tbody>
        {{range .Observations}}
          <tr class="{{if .Latest}}obs-latest{{end}}">
            <td>{{.Year}}</td><td>{{.Stage}}</td><td class="num">{{.Amount}}</td>
          </tr>
        {{end}}
        </tbody>
      </table>
      {{end}}
      <p>{{.Note}}</p>
      <p class="budget-finding-links">
        {{if .HasStatement}}<a href="/utsagn/{{.StatementNum}}">Utsagn {{.StatementNum}}: {{.StatementName}} <span aria-hidden="true">→</span></a>{{else}}<span class="budget-nostmt">Ingen utsagn dekker dette ennå</span>{{end}}
        · <a href="{{.SourceURL}}" rel="noopener">Kilde</a>
      </p>
    </article>
    {{end}}
  </details>
</main>

<footer class="wrap"><p>Ekte valgomat viser hva partiene sier og hva de gjorde, hver for seg, med kilder. Se <a href="/metode">metoden</a>. Datasettet kan lastes ned under <a href="/data">åpne data</a>.</p>  {{template "footerlinks"}}
</footer>
</body>
</html>
