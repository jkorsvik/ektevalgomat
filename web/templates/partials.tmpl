{{/* Shared by every page (see server.go's page()). No file name with a
     leading underscore: go:embed would silently skip it. */}}
{{/* Takes a pageMeta (server/meta.go). Title, description, canonical and
     Open Graph live here so no page can forget them — before 2026-10-13 only
     two pages of seventy-odd had a description, none had a canonical link and
     none had an og tag, so a shared link produced no preview. */}}
{{define "head"}}
<title>{{.Title}}</title>
{{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">
<meta property="og:url" content="{{.Canonical}}">{{end}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Ekte valgomat">
<meta property="og:locale" content="nb_NO">
<meta property="og:title" content="{{.Title}}">
{{if .Description}}<meta property="og:description" content="{{.Description}}">{{end}}
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#f7f5f0">
<link rel="icon" type="image/svg+xml" href="{{asset "/static/favicon.svg"}}">
<link rel="preload" href="/static/fonts/IBMPlexSerif-SemiBold-Latin1.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{asset "/static/css/style.css"}}">
{{end}}

{{/* The mark, [e]: "ekte" inside citation brackets, i.e. the answer sits
     inside its sources. Strokes only, colour from .brand-mark in CSS.
     favicon.svg is the same mark with wider brackets for 16 px. */}}
{{define "header"}}<header class="site">
  <div class="wrap">
    <p class="site-title"><a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M10 5H5v22h5M22 5h5v22h-5M11.5 16h9a4.5 4.5 0 1 0-1.3 3.2"/></svg>Ekte valgomat</a></p>
    <nav aria-label="Hovedmeny">
      {{range nav}}<a href="{{.Href}}"{{if eq .Href $.Meta.Path}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}
    </nav>
  </div>
</header>{{end}}

{{define "footerlinks"}}<p class="footer-links"><a href="/kart">Kartet</a> · <a href="/tidslinje">År for år</a> · <a href="/rommet">Rommet</a> · <a href="/stemmer">Stemmemønster</a> · <a href="/penger">Penger</a> · <a href="/eierskap">Statens eierskap</a> · <a href="/makt">Makt</a> · <a href="/bidra">Det som mangler</a> · <a href="/data">Åpne data</a> · <a href="/metode">Metoden</a></p>{{end}}
