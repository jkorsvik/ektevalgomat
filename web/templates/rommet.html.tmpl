<!doctype html>
<html lang="nb">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{template "head" .Meta}}
<link rel="stylesheet" href="{{asset "/static/css/prose.css"}}">
<link rel="stylesheet" href="{{asset "/static/css/rommet.css"}}">
</head>
<body>

{{template "header" .}}

<main class="rom-comparison">
  <header class="rom-hero">
    <span class="snapshot-badge">Kilder til og med {{.SnapshotDate}}</span>
    <p class="rom-kicker">Sammenlign posisjoner</p>
    <h1>Hva skiller partiene?</h1>
    <p class="rom-lede">
      Se konkrete saker der partiene har svart ulikt. Velg et tema eller to
      partier. Hvert navn tar deg til begrunnelsen og kilden for akkurat det svaret.
    </p>
  </header>

  <section class="rom-finder" aria-labelledby="rom-finder-title">
    <div class="rom-finder-heading">
      <p class="rom-kicker">Finn en reell uenighet</p>
      <h2 id="rom-finder-title">Hva vil du sammenligne?</h2>
      <p>Uten valg viser vi seks saker med tydelig uenighet. Med to partier viser vi bare sakene der de er uenige.</p>
    </div>
    <form class="rom-controls" action="/rommet#saker" method="get">
      <label class="rom-control rom-control-topic">
        <span>Tema</span>
        <select id="rom-topic" name="tema">
          <option value="">Alle temaer</option>
          {{range .Topics}}<option value="{{.Slug}}"{{if .Active}} selected{{end}}>{{.Name}}</option>{{end}}
        </select>
      </label>
      <label class="rom-control">
        <span>Første parti</span>
        <select id="rom-party-a" name="a">
          <option value="">Velg parti</option>
          {{range .Parties}}<option value="{{.ID}}"{{if .SelectedA}} selected{{end}}>{{.Name}}</option>{{end}}
        </select>
      </label>
      <label class="rom-control">
        <span>Andre parti</span>
        <select id="rom-party-b" name="b">
          <option value="">Velg parti</option>
          {{range .Parties}}<option value="{{.ID}}"{{if .SelectedB}} selected{{end}}>{{.Name}}</option>{{end}}
        </select>
      </label>
      <button class="rom-submit" type="submit">Vis uenigheter</button>
    </form>
    {{if .Notice}}<p class="rom-notice" role="alert">{{.Notice}}</p>{{end}}
    {{if .Filtered}}<p class="rom-reset"><a href="/rommet">Nullstill valgene</a></p>{{end}}
  </section>

  <section class="rom-results" id="saker" aria-labelledby="rom-results-title">
    <div class="rom-results-heading">
      <div>
        <p class="rom-kicker">Utsagn for utsagn</p>
        <h2 id="rom-results-title">Her går partiene i ulike retninger</h2>
      </div>
      <p class="rom-summary" role="status">{{.Summary}}</p>
    </div>
    <p class="rom-sort-note">Rekkefølgen måler avstanden mellom svarene, ikke hvor viktig saken er.</p>

    {{if .Statements}}
    <div class="rom-statements">
      {{range .Statements}}
      <article class="rom-statement">
        <header class="rom-statement-head">
          <div>
            <p class="rom-statement-meta">Utsagn {{.Number}} <span aria-hidden="true">·</span> {{.Dimension}}</p>
            <h3><a href="{{.Href}}">{{.ShortName}}</a></h3>
            <p class="rom-statement-text">{{.Text}}</p>
          </div>
          <a class="rom-open" href="{{.Href}}">Se hele saken <span aria-hidden="true">→</span></a>
        </header>

        {{if .PairGap}}<p class="rom-pair-gap">{{.PairGap}}</p>{{end}}

        <div class="rom-positions" role="group" aria-label="Partienes posisjoner på utsagn {{.Number}}">
          {{range .Groups}}
          <section class="rom-position">
            <h4>{{.Label}}</h4>
            {{if .Parties}}
            <ul>
              {{range .Parties}}
              <li><a class="rom-party{{if .Selected}} is-selected{{end}}" href="{{.Href}}" aria-label="{{.AriaLabel}}"><span class="rom-dot rom-dot-{{.ID}}" aria-hidden="true"></span>{{.Short}}</a></li>
              {{end}}
            </ul>
            {{else}}<p class="rom-empty">Ingen</p>{{end}}
          </section>
          {{end}}
        </div>

        <div class="rom-statement-foot">
          <span>{{.Coded}} av {{.Total}} partier har et dokumentert svar</span>
          {{if .Undocumented}}
          <span class="rom-undocumented">Ikke vurdert:
            {{range $i, $p := .Undocumented}}{{if $i}}, {{end}}<a href="{{$p.Href}}" aria-label="{{$p.AriaLabel}}">{{$p.Short}}</a>{{end}}
          </span>
          {{end}}
        </div>
      </article>
      {{end}}
    </div>
    {{if not .Filtered}}
    <a class="rom-all" href="{{.AllHref}}">Se alle {{.TotalMatches}} uenighetene <span aria-hidden="true">→</span></a>
    {{end}}
    {{else}}
    <div class="rom-no-results">
      <h3>Ingen uenigheter å vise her</h3>
      <p>Prøv et annet tema eller et annet partipar. Partiene kan også mangle dokumenterte svar på samme sak.</p>
      <a href="/rommet">Se de største uenighetene</a>
    </div>
    {{end}}
  </section>

  <details class="rom-method">
    <summary>Slik leser du posisjonene</summary>
    <div class="rom-method-body">
      <p><strong>For og mot gjelder alltid det konkrete utsagnet.</strong> Skalaen er ikke en venstre–høyre-akse. Vi viser den nyeste daterte kildens posisjon, ikke et gjennomsnitt av gamle og nye svar.</p>
      <p>Et parti uten kodet posisjon står under «Ikke vurdert». Det blir aldri regnet som nøytralt. Sorteringen bruker avstanden på skalaen fra sterkt mot til sterkt for.</p>
      <p><a href="/metode">Les metoden</a> eller åpne et partinavn for å kontrollere den konkrete kilden.</p>
      {{template "explore-contract" (explore "/rommet")}}
    </div>
  </details>

  {{template "explore-next" (explore "/rommet")}}
</main>

<footer class="site">
  <p>Posisjonene kommer fra den åpne kildebasen. <a href="/data">Åpne data</a> · <a href="/metode">Metoden</a></p>
  {{template "footerlinks"}}
</footer>
</body>
</html>
